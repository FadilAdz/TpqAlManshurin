        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor white\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityFontColor black\nskinparam ArrowColor black\nskinparam shadowing false\nskinparam ConditionEndStyle diamond\n\n|Admin|\nstart\n:Akses Halaman\\nKelola Nasehat;\n\n|Sistem|\n:Menampilkan Daftar Nasehat;\n\n|Admin|\nif (Pilih Aksi?) then (Tambah/Edit)\n  :Memasukkan/menyesuaikan\\ndata nasehat;\nelse (Hapus)\n  :Klik Hapus &amp;\\nKonfirmasi Penghapusan;\nendif\n\n|Sistem|\n:Validasi data &amp; proses\\nke database;\nif (Validasi OK?) then (Ya)\n  :Menampilkan\\nnotifikasi sukses;\n  :Memperbarui tampilan\\ndaftar nasehat;\nelse (Tidak)\n  :Menampilkan\\npesan error;\nendif\n\n|Admin|\nstop\n@enduml\n\n\n-- D2. Activity Diagram Mengelola Galeri Kegiatan --\n(Paste di draw.io: Extras &gt; Edit Diagram &gt; pilih PlantUML)\n\n@startuml\nskinparam backgroundColor white\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityFontColor black\nskinparam ArrowColor black\nskinparam shadowing false\nskinparam ConditionEndStyle diamond\n\n|Admin|\nstart\n:Akses Halaman\\nManajemen Galeri;\n\n|Sistem|\n:Menampilkan Daftar\\nGaleri Kegiatan;\n\n|Admin|\nif (Pilih Aksi?) then (Upload/Urutkan)\n  :Upload Gambar Baru atau\\nDrag &amp; Drop Urutan Foto;\nelse (Hapus)\n  :Klik Hapus &amp;\\nKonfirmasi Penghapusan;\nendif\n\n|Sistem|\n:Proses Data\\nke Database;\nif (Proses Berhasil?) then (Ya)\n  :Menampilkan\\nnotifikasi sukses;\n  :Memperbarui tampilan\\ndaftar galeri;\nelse (Tidak)\n  :Menampilkan\\npesan error;\nendif\n\n|Admin|\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0y7DpQLNoabtxaI-konG-31">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1936" width="9380" as="geometry" />
