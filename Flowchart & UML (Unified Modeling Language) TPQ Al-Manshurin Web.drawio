        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Styling Hitam Putih Polos\n    classDef default fill:#fff,stroke:#000,stroke-width:1.5px,color:#000\n    classDef pimpinan fill:#fff,stroke:#000,stroke-width:3px,color:#000,font-weight:bold\n\n    %% Pimpinan Utama (Paling Atas)\n    Ketua[\&quot;&lt;b&gt;KETUA TPQ&lt;/b&gt;&lt;br/&gt;Bp. M.Hulaimul Fikri\&quot;]:::pimpinan\n\n    %% Baris Pertama (3 Kolom biar nggak lebar ke samping)\n    Wakil[\&quot;&lt;b&gt;WAKIL KETUA&lt;/b&gt;&lt;br/&gt;Wakil 1: Bp. Pandu Prameswara&lt;br/&gt;Wakil 2: Bp. Ravido Sakti Muryanto\&quot;]\n    Sekretaris[\&quot;&lt;b&gt;SEKRETARIS &amp; PEMBINA&lt;/b&gt;&lt;br/&gt;Sek Umum: Bp. Bangga Atmaja&lt;br/&gt;Pembina: Bp. Yuntopo Yoga\&quot;]\n    Keamanan[\&quot;&lt;b&gt;SEKSI KEAMANAN&lt;/b&gt;&lt;br/&gt;Bp. Rifki Nur fadilah&lt;br/&gt;Bp. Fauzan&lt;br/&gt;Bp. Sidal\&quot;]\n\n    %% Hubungan dari Ketua ke 3 Pilar\n    Ketua --&gt; Wakil\n    Ketua --&gt; Sekretaris\n    Ketua --&gt; Keamanan\n\n    %% Baris Kedua (Digantung/ditumpuk ke bawah seperti referensi temen lo)\n    Bendahara[\&quot;&lt;b&gt;BENDAHARA &amp; KEUANGAN&lt;/b&gt;&lt;br/&gt;Utama: Bp. Adis Fariedsi&lt;br/&gt;Keuangan: Bp. Abdul Rojaq\&quot;]\n    Pakar[\&quot;&lt;b&gt;PAKAR &amp; KOORDINATOR&lt;/b&gt;&lt;br/&gt;Pendidik: Bp. Kustian Guntolo&lt;br/&gt;Koord Ibu-ibu: Ibu Evanti Andriani\&quot;]\n    Ustadz[\&quot;&lt;b&gt;USTADZ (TENAGA PENGAJAR)&lt;/b&gt;&lt;br/&gt;Sdr. Fajar Syahri&lt;br/&gt;Sdr. Putra&lt;br/&gt;Sdr. Dwika&lt;br/&gt;Sdr. Ahmad Subhi Aljava\&quot;]\n\n    %% Garis gantung vertikal (pakai garis lurus biasa tanpa panah)\n    Wakil --- Bendahara\n    Sekretaris --- Pakar\n    Keamanan --- Ustadz&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Y6rGyWLnAH7Ii_7lhrNw-124">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="3260" width="4953" as="geometry" />
          </mxCell>
        </UserObject>
