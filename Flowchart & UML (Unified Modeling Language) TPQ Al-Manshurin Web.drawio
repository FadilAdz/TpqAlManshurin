        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Admin\n    participant UI as Frontend (Browser)\n    participant API as API Route (/api/auth/login)\n    participant Auth as Auth Service (Bcrypt &amp; JWT)\n    participant DB as SQLite Database\n    \n    Admin-&gt;&gt;UI: Input Username &amp; Password, Klik Login\n    activate UI\n    UI-&gt;&gt;API: HTTP POST /api/auth/login (payload: credentials)\n    activate API\n    API-&gt;&gt;DB: SELECT * FROM admin_users WHERE username = ?\n    activate DB\n    DB--&gt;&gt;API: Data Admin (termasuk password_hash)\n    deactivate DB\n    \n    alt User Tidak Ditemukan\n        API--&gt;&gt;UI: Response JSON 401 Unauthorized\n    else User Ditemukan\n        API-&gt;&gt;Auth: Bcrypt.compare(password_input, password_hash)\n        activate Auth\n        \n        alt Password Salah\n            Auth--&gt;&gt;API: Result = false\n            API--&gt;&gt;UI: Response JSON 401 Unauthorized\n        else Password Benar\n            Auth--&gt;&gt;API: Result = true\n            API-&gt;&gt;Auth: JWT.sign({ userId, role }, secret)\n            Auth--&gt;&gt;API: JWT Token (String)\n            deactivate Auth\n            \n            API--&gt;&gt;UI: Response JSON 200 OK (Set-Cookie: token)\n        end\n    end\n    deactivate API\n    \n    UI--&gt;&gt;Admin: Redirect ke Halaman Dashboard Admin\n    deactivate UI&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CiGZ1kQsGymccHeP1tId-22">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Admin" mermaidId="n:Admin" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Admin" id="CiGZ1kQsGymccHeP1tId-23">
