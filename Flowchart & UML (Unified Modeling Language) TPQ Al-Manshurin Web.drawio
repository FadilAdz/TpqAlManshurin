        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor white\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityFontColor black\nskinparam ArrowColor black\nskinparam shadowing false\nskinparam ConditionEndStyle diamond\n\n|Admin|\nstart\n:Akses Halaman\\nManajemen Galeri;\n\n|Sistem|\n:Menampilkan Daftar\\nGaleri Kegiatan;\n\n|Admin|\n|Admin|\nif (Kategori Aksi?) then (Upload / Hapus)\n  if (Pilih Aksi?) then (Upload Foto)\n    :Pilih &amp; Upload\\nGambar Baru;\n    |Sistem|\n    :Proses Simpan\\nke Database;\n    if (Berhasil?) then (Ya)\n      :Menampilkan\\nnotifikasi sukses;\n      :Memperbarui tampilan\\ndaftar galeri;\n    else (Tidak)\n      :Menampilkan\\npesan error;\n    endif\n    |Admin|\n    stop\n  else (Hapus Foto)\n    |Admin|\n    :Klik Hapus &amp;\\nKonfirmasi Penghapusan;\n    |Sistem|\n    :Hapus Data\\ndari Database;\n    if (Berhasil?) then (Ya)\n      :Menampilkan\\nnotifikasi sukses;\n      :Memperbarui tampilan\\ndaftar galeri;\n    else (Tidak)\n      :Menampilkan\\npesan error;\n    endif\n    |Admin|\n    stop\n  endif\nelse (Set Gambar Utama)\n  |Admin|\n  :Drag &amp; Drop Foto\\nke Urutan Pertama;\n  |Sistem|\n  :Update Status Foto\\nMenjadi Gambar Utama;\n  :Memperbarui Tampilan\\nGaleri Utama Web;\n  |Admin|\n  stop\nendif\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OWZjCRU0O9cdS20lBTo--1">
